<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  mujin-framework 代码风格约束（Checkstyle）
  ------------------------------------------------------------
  适用版本：Checkstyle 9.x 及以上
  适用 JDK ：21
  使用方式：
    1. 在 pom 中加入 maven-checkstyle-plugin 引用本文件；
    2. 或在 IDE 中安装 Checkstyle 插件并选择本配置。
  ------------------------------------------------------------
-->

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java, properties, xml"/>
    <property name="localeLanguage" value="zh_CN"/>

    <!-- 允许的最大文件长度（行数） -->
    <property name="maxFileLength" value="2500"/>

    <!-- 单行最大长度（项目中文注释偏多，留宽一些） -->
    <module name="LineLength">
        <property name="max" value="180"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|@see|@link"/>
    </module>

    <!-- 文件末尾必须换行 -->
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf_cr_crlf"/>
    </module>

    <!-- 不允许使用 Tab -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- =================== TreeWalker =================== -->
    <module name="TreeWalker">
        <!-- ============ 基础 Java 规则 ============ -->
        <module name="OuterTypeFilename"/>
        <module name="UniqueProperty"/>
        <module name="AvoidEscapedUnicodeCharacters">
            <property name="allowEscapesForControlCharacters" value="true"/>
            <property name="allowByTailComment" value="true"/>
            <property name="allowNonPrintableEscapes" value="true"/>
        </module>

        <!-- ============ 命名规范 ============ -->
        <!-- 包名全小写，数字分隔的点 -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
            <message key="name.invalidPattern"
                     value="包名 ''{0}'' 必须全小写、点分隔。"/>
        </module>

        <!-- 类/接口/枚举：UpperCamelCase，禁 I 前缀 -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
                     value="类型名 ''{0}'' 必须遵循 UpperCamelCase，不要加 I 前缀。"/>
        </module>

        <!-- 常量：UPPER_SNAKE_CASE -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <!-- 静态（final）变量也遵循常量命名 -->
        <module name="StaticVariableName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <!-- 成员变量：lowerCamelCase -->
        <module name="MemberName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*|[A-Z][A-Z0-9_]*)$"/>
        </module>

        <!-- 局部变量：lowerCamelCase -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 形参：lowerCamelCase -->
        <module name="FormalParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 方法名：lowerCamelCase -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
            <property name="allowClassName" value="false"/>
        </module>

        <!-- Lambda 参数名 -->
        <module name="LambdaParameterName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*|[a-z]+(_[a-z]+)*)$"/>
        </module>

        <!-- ============ import 规则 ============ -->
        <!-- 不允许 * 通配符导入 -->
        <module name="AvoidStarImport"/>
        <!-- 不允许未使用的导入 -->
        <module name="UnusedImports"/>
        <!-- 不允许重复导入 -->
        <module name="RedundantImport"/>
        <!-- 导入顺序：java.*、javax.*、第三方（a-z） -->
        <module name="ImportOrder">
            <property name="groups" value="java,javax,*,com"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
            <property name="option" value="above"/>
            <property name="staticGroups" value="org.junit,org.springframework,org.projectlombok,java.lang"/>
        </module>

        <!-- ============ 大小与行数限制 ============ -->
        <module name="MethodLength">
            <property name="max" value="200"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="10"/>
            <property name="ignoreOverriddenMethods" value="true"/>
            <property name="ignoreConstructors" value="false"/>
        </module>
        <module name="AnonInnerLength">
            <property name="max" value="80"/>
        </module>
        <module name="ExecutableStatementCount">
            <property name="max" value="60"/>
        </module>

        <!-- ============ 代码风格 ============ -->
        <!-- 缩进 4 空格 -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="4"/>
            <property name="lineWrappingIndentation" value="4"/>
            <property name="arrayInitIndent" value="4"/>
        </module>

        <!-- 大括号 -->
        <module name="NeedBraces"/>
        <module name="LeftCurly">
            <property name="option" value="nl"/>
            <property name="tokens" value="INTERFACE_DEF,CLASS_DEF,CTOR_DEF,METHOD_DEF,STATIC_INIT,INSTANCE_INIT"/>
        </module>
        <module name="RightCurly">
            <property name="option" value="same"/>
        </module>

        <!-- 一行一条语句 -->
        <module name="OneStatementPerLine"/>

        <!-- 一行一个声明 -->
        <module name="MultipleVariableDeclarations"/>

        <!-- if/else 必须使用大括号 -->
        <module name="AvoidNestedBlocks"/>

        <!-- 禁止空块（catch 块允许空） -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_TRY, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_SWITCH"/>
        </module>

        <!-- ============ 注释与 Javadoc ============ -->
        <!-- 类必须有 Javadoc（枚举/接口/注解同样适用） -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowUnknownTags" value="false"/>
            <property name="allowedAnnotations" value="Override,FunctionalInterface,Target,Retention,Documented,Inherited,SpringBootApplication,Configuration,Service,Component,Repository,Bean,AutoConfiguration,ConditionalOnXxx,Conditional,EnableXxx"/>
        </module>

        <!-- 方法必须有 Javadoc -->
        <module name="JavadocMethod">
            <property name="scope" value="public"/>
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowMissingReturnTag" value="false"/>
            <property name="allowedAnnotations" value="Override,Bean"/>
            <property name="tokens" value="METHOD_DEF,CTOR_DEF,ANNOTATION_FIELD_DEF,COMPACT_CTOR_DEF"/>
        </module>

        <!-- 风格：Javadoc 第一行以句号结尾或满足条件 -->
        <module name="JavadocContentLocation">
            <property name="location" value="first_line"/>
        </module>
        <module name="JavadocParagraph">
            <property name="allowNewlineParagraph" value="false"/>
        </module>

        <!-- 不允许在行尾写注释 -->
        <module name="TrailingComment"/>
        <!-- 不允许过时注释 TODO 警告 -->
        <module name="TodoComment">
            <property name="format" value="(?i)(TODO|FIXME|XXX)"/>
        </module>

        <!-- ============ 设计建议 ============ -->
        <!-- 禁用 System.out / System.err（仅在 main 中允许） -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="ignoreComments" value="true"/>
            <property name="ignoreMessage" value="允许 main 方法中使用"/>
        </module>

        <!-- 不允许 tab 字符 -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="^\s*\*\s*[^/]\s*$"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="不允许行尾注释（使用 Javadoc 或独立行注释）"/>
        </module>

        <!-- 静态导入 Lombok 的 @Slf4j / @Data 等注解时建议使用 * 通配符的反例不允许 -->
        <module name="ImportRegexSingleline">
            <property name="format" value="^import (?!static ).*\*;$"/>
            <property name="message" value="禁止通配符 import"/>
        </module>

        <!-- ============ Java 17+ 语法兼容 ============ -->
        <module name="SuppressWarningsHolder"/>

        <!-- ============ Annotation 相关 ============ -->
        <module name="AnnotationLocation"/>
        <module name="AnnotationUseStyle"/>
        <module name="MissingDeprecated"/>
        <module name="MissingOverride"/>
        <module name="PackageDeclaration"/>
        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>
        <module name="ModifierOrder"/>
        <module name="CovariantEquals"/>
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="FallThrough"/>
        <module name="NestedForDepth">
            <property name="max" value="2"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>
        <module name="NestedTryDepth">
            <property name="max" value="2"/>
        </module>
        <module name="OuterTypeNumber"/>
        <module name="InnerAssignment"/>
        <module name="MissingSwitchDefault"/>
        <module name="DefaultComesLast"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="UnnecessaryParentheses"/>
        <module name="WhitespaceAround">
            <property name="tokens" value="ASSIGN, BAND, BOR, BSR, BXOR, COLON, DIV, EQUAL, GE, GT, LAND, LE, LITERAL_ASSERT, LITERAL_CATCH, LITERAL_DO, LITERAL_ELSE, LITERAL_FINALLY, LITERAL_FOR, LITERAL_IF, LITERAL_RETURN, LITERAL_SYNCHRONIZED, LITERAL_TRY, LITERAL_WHILE, LOR, LT, MINUS, MOD, NOT_EQUAL, PLUS, QUESTION, SL, SR, STAR, TYPE_EXTENSION_AND"/>
        </module>
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="GenericWhitespace"/>
        <module name="EmptyForInitializerPad"/>
        <module name="EmptyForIteratorPad"/>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>
        <module name="TypecastParenPad"/>
        <module name="TypecastWhitespace"/>
    </module>

    <!-- 抑制：Lombok 生成方法未写 Javadoc（数据类常用） -->
    <module name="SuppressionFilter">
        <property name="file" value="${configLoc}/suppressions.xml"/>
        <property name="optional" value="true"/>
    </module>
</module>
