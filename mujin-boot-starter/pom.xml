<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mujin</groupId>
        <artifactId>mujin-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.mujin.boot</groupId>
    <artifactId>mujin-boot-starter</artifactId>
    <name>mujin-boot-starter</name>
    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-common</artifactId>
            <version>2.7.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mujin.commons</groupId>
            <artifactId>commons-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
    </dependencies>
    <packaging>pom</packaging>
    <modules>
        <module>mujin-web-boot-starter</module>
        <module>mujin-web-security</module>
        <module>mujin-web-cache</module>
        <module>mujin-web-orm</module>
        <module>mujin-web-logging</module>
        <module>mujin-web-logging-db</module>
        <module>mujin-web-logging-kafka</module>
        <module>mujin-web-model</module>
        <module>mujin-web-document</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- 公共模块：commons-* 子模块统一在此 manage，避免子模块声明时缺 version -->
            <dependency>
                <groupId>com.mujin.commons</groupId>
                <artifactId>commons-lang</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mujin.commons</groupId>
                <artifactId>commons-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mujin.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mujin.boot</groupId>
                <artifactId>mujin-web-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mujin.boot</groupId>
                <artifactId>mujin-web-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mujin.boot</groupId>
                <artifactId>mujin-web-cache</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mujin.boot</groupId>
                <artifactId>mujin-web-orm</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mujin.boot</groupId>
                <artifactId>mujin-web-logging</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mujin.boot</groupId>
                <artifactId>mujin-web-logging-db</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mujin.boot</groupId>
                <artifactId>mujin-web-logging-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mujin.boot</groupId>
                <artifactId>mujin-web-model</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>
